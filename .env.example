# ============================================================
# Carelim Healthcare Platform — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# Generate secrets with:
#   openssl rand -hex 32
# ============================================================

# ---- PostgreSQL Database ----
POSTGRES_USER=carelim
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=carelim

# Auto-generated DATABASE_URL (used by Prisma & all apps)
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?schema=public"

# ---- Authentication ----
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-generate-a-random-secret
NEXTAUTH_SECRET=${JWT_SECRET}

# ---- App URLs ----
# Update these with your actual domains in production
NEXTAUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ---- Backend API ----
# Internal Docker network URL (used between containers)
# BACKEND_INTERNAL_URL=http://backend:4000
# External URL (used by browsers)
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Ports (used in docker-compose.yml) ----
# FRONTEND_PORT=3000
# BACKEND_PORT=4000
# SAAS_PORT=3001
# MS_PORT=3002
# MARKETPLACE_PORT=3003
