// ============================================================
// IVF & Fertility Add-on Module
// ============================================================

model IVFCycle {
  id              String   @id @default(cuid())
  cycleNo         String   @unique
  patientId       String
  partnerId       String?
  doctorId        String?
  cycleNumber     Int      @default(1)
  status          String   @default("planned") // planned | stimulation | monitoring | opu | transfer | wait | pregnant | failed | cancelled
  startDate       DateTime @default(now())
  endDate         DateTime?
  protocolId      String?
  stimulationStart DateTime?
  stimulationEnd  DateTime?
  opuDate         DateTime?
  transferDate    DateTime?
  pregnancyTestDate DateTime?
  pregnancyResult String?  // positive | negative | pending
  notes           String?
  totalCost       Float    @default(0)
  paidAmount      Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  follicularRecords FollicularMonitoring[]
  embryoRecords   Embryo[]
  transfers       EmbryoTransfer[]
  pregnancy       PregnancyFollowup?
}

model FertilityAssessment {
  id          String   @id @default(cuid())
  patientId   String
  partnerId   String?
  assessmentDate DateTime @default(now())
  femaleWorkup String?  // AMH, FSH, LH, E2, AFC, HSG, etc.
  maleWorkup  String?  // Semen analysis, hormone, USG
  diagnosis   String?
  amh         Float?
  fsh         Float?
  lh          Float?
  e2          Float?
  afc         Int?
  bmi         Float?
  prognosis   String?  // good | fair | poor
  recommendations String?
  doctorId    String?
  createdAt   DateTime @default(now())
}

model TreatmentProtocol {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  type        String   @default("antagonist") // antagonist | agonist | natural | mild
  duration    Int      @default(12) // days
  medications String?  // JSON: medication schedule
  monitoring  String?  // monitoring schedule
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model FollicularMonitoring {
  id          String   @id @default(cuid())
  cycleId     String
  cycle       IVFCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  monitoringDate DateTime @default(now())
  day         Int      @default(1)
  leftFollicles Json?
  rightFollicles Json?
  endometrium Float?  // mm
  e2          Float?  // pg/mL
  lh          Float?
  p4          Float?  // progesterone
  notes       String?
  doctorId    String?
  createdAt   DateTime @default(now())
}

model EggRetrieval {
  id          String   @id @default(cuid())
  cycleId     String   @unique
  opuDate     DateTime @default(now())
  folliclesPunctured Int @default(0)
  oocytesRetrieved Int  @default(0)
  matureOocytes Int     @default(0)
  immatureOocytes Int  @default(0)
  atreticOocytes Int   @default(0)
  sedation    String?
  complications String?
  embryologist String?
  doctorId    String?
  notes       String?
  createdAt   DateTime @default(now())
}

model SemenProcessing {
  id              String   @id @default(cuid())
  cycleId         String?
  patientId       String?
  donorId         String?
  collectionDate  DateTime @default(now())
  volume          Float?
  concentration   Float?  // million/ml
  motility        Float?  // %
  morphology      Float?  // %
  processingMethod String? // swim-up | density gradient | icsi | pgt
  postWashConcentration Float?
  postWashMotility Float?
  viableCount     Int?
  notes           String?
  createdAt       DateTime @default(now())
}

model Embryo {
  id          String   @id @default(cuid())
  cycleId     String
  cycle       IVFCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  embryoNo    Int      @default(1)
  day         Int      @default(1) // day 1-7
  cellCount   Int?
  grade       String?  // 1AA, 2BB, etc.
  quality     String?  // excellent | good | fair | poor
  status      String   @default("cultured") // cultured | frozen | transferred | discarded
  frozenDate  DateTime?
  thawedDate  DateTime?
  transferId  String?
  notes       String?
  createdAt   DateTime @default(now())
}

model EmbryoTransfer {
  id          String   @id @default(cuid())
  cycleId     String
  cycle       IVFCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  transferDate DateTime @default(now())
  transferType String  @default("fresh") // fresh | frozen | donor
  embryosTransferred Int @default(1)
  embryoIds   String?  // comma-separated embryo IDs
  catheter    String?
  difficulty  String?  // easy | moderate | difficult
  doctorId    String?
  notes       String?
  createdAt   DateTime @default(now())
}

model CryobankStorage {
  id          String   @id @default(cuid())
  barcode     String   @unique
  type        String   // embryo | oocyte | sperm
  patientId   String?
  donorId     String?
  cycleId     String?
  tankNumber  String?
  canisterPosition String?
  canePosition String?
  freezeDate  DateTime @default(now())
  expiryDate  DateTime?
  status      String   @default("stored") // stored | thawed | transferred | discarded
  quantity    Int      @default(1)
  notes       String?
  createdAt   DateTime @default(now())
}

model PregnancyFollowup {
  id          String   @id @default(cuid())
  cycleId     String   @unique
  cycle       IVFCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  testDate    DateTime @default(now())
  betaHcg     Float?
  result      String   @default("pending") // positive | negative | pending
  sacVisible  Boolean  @default(false)
  heartbeat   Boolean  @default(false)
  fetalCount  Int      @default(0)
  gestationalAge Int   @default(0) // weeks
  edd         DateTime? // estimated due date
  complications String?
  status      String   @default("tracking") // tracking | ongoing | delivered | miscarried | ectopic
  notes       String?
  createdAt   DateTime @default(now())
}

model DonorProfile {
  id          String   @id @default(cuid())
  donorCode   String   @unique
  type        String   // egg | sperm | embryo
  anonymous   Boolean  @default(true)
  age         Int?
  bloodGroup  String?
  height      Float?
  weight      Float?
  education   String?
  physicalTraits String?
  medicalHistory String?
  geneticScreening String?
  screeningStatus String @default("pending") // pending | cleared | rejected
  status      String   @default("active") // active | used | retired
  createdAt   DateTime @default(now())
}

model IVFConsent {
  id          String   @id @default(cuid())
  consentNo   String   @unique
  patientId   String
  partnerId   String?
  cycleId     String?
  type        String   // ivf_treatment | icsi | embryo_freezing | donor | surrogacy | pgd
  title       String
  description String?
  signedBy    String?
  signedDate  DateTime?
  status      String   @default("pending") // pending | signed | declined
  witness     String?
  documentUrl String?
  createdAt   DateTime @default(now())
}

model IVFPackage {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  totalCost   Float    @default(0)
  includes    String?  // JSON: list of included services
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ============================================================
// Dental Add-on Module
// Independent of core HMS tables. Reuses Patient / Doctor /
// Appointment / Invoice / InventoryItem / AuditLog by ID only.
// ============================================================

model DentalExamination {
  id                  String   @id @default(cuid())
  examNo              String   @unique
  patientId           String   // -> Patient.id
  doctorId            String?  // -> Doctor.id
  appointmentId       String?  // -> Appointment.id
  examDate            DateTime @default(now())
  chiefComplaint      String?
  medicalHistory      String?
  dentalHistory       String?
  extraOral           String?  // JSON: face, lymph nodes, TMJ palpation
  intraOral           String?  // JSON: lips, cheeks, tongue, floor, palate, gingiva
  occlusion           String?  // class I | II | III | crossbite | open bite | deep bite
  tmjAssessment       String?
  softTissueFindings  String?
  hardTissueFindings  String?
  periodontalExam     String?  // JSON: probing depths, recession, mobility, furcation
  diagnosis           String?
  clinicalNotes        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt
}

model Odontogram {
  id          String   @id @default(cuid())
  patientId   String   // -> Patient.id
  numberingSystem String @default("fdi") // fdi | universal | palmer
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  teeth       Tooth[]
}

model Tooth {
  id           String   @id @default(cuid())
  odontogramId String
  odontogram   Odontogram @relation(fields: [odontogramId], references: [id], onDelete: Cascade)
  toothNumber  String   // FDI (11-48, 51-85) or Universal (1-32)
  isPrimary    Boolean  @default(false)
  // surface states stored as JSON so we can store many conditions per tooth
  conditions   String?  // JSON: [{ type, date, note }]
  // current surface markers
  status       String   @default("sound") // sound | missing | decayed | filled | crown | bridge | implant | root_canal | extraction | fracture | mobility | sealant | impacted
  surfaces     String?  // JSON: { mesial, distal, buccal, lingual, occlusal }
  notes        String?
  updatedAt    DateTime @default(now()) @updatedAt
}

model DentalTreatmentPlan {
  id            String   @id @default(cuid())
  planNo        String   @unique
  patientId     String
  doctorId      String?
  appointmentId String?
  toothNumbers  String?  // comma-separated FDI numbers
  diagnosis     String?
  treatmentType String   // scaling | polishing | composite_filling | amalgam_filling | rct | extraction | surgical_extraction | crown | bridge | implant | orthodontics | dentures | veneers | whitening | perio_surgery
  estimatedCost Float    @default(0)
  status        String   @default("planned") // planned | approved | in_progress | completed | cancelled
  consentSigned Boolean  @default(false)
  consentDate   DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

model DentalProcedure {
  id             String   @id @default(cuid())
  procNo         String   @unique
  patientId      String
  doctorId       String?
  assistantId    String?
  appointmentId  String?
  treatmentPlanId String?
  procedureDate  DateTime @default(now())
  toothNumbers   String?  // comma-separated
  procedureType  String
  materialsUsed  String?  // JSON: [{ itemId, name, qty }]
  medicineUsed   String?  // JSON: [{ medicineId, name, qty, instruction }]
  notes          String?
  complications  String?
  images         String?  // JSON: array of image URLs / base64
  duration       Int      @default(0) // minutes
  invoiceId      String?  // -> Invoice.id (auto-created)
  status         String   @default("completed") // scheduled | in_progress | completed | cancelled
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
}

model DentalImage {
  id          String   @id @default(cuid())
  patientId   String
  procedureId String?
  imageType   String   // iopa | opg | cbct | ceph | clinical_photo | before_after
  title       String?
  imageUrl    String?  // URL or base64
  annotation  String?  // JSON: annotation overlays
  takenAt     DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())
}

model DentalLabOrder {
  id            String   @id @default(cuid())
  orderNo       String   @unique
  patientId     String
  doctorId      String?
  procedureId   String?
  labType       String   // crown | bridge | denture | aligner | implant | other
  toothNumbers  String?
  material      String?
  shade         String?
  technician    String?
  labName       String?
  status        String   @default("pending") // pending | in_lab | ready | delivered | returned
  sentDate      DateTime @default(now())
  deliveryDate  DateTime?
  receivedDate  DateTime?
  cost          Float    @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

model OrthodonticCase {
  id             String   @id @default(cuid())
  caseNo         String   @unique
  patientId      String
  doctorId       String?
  treatmentType  String   @default("braces") // braces | aligners | functional | retainer
  startDate      DateTime @default(now())
  endDate        DateTime?
  bracketType    String?  // metal | ceramic | self_ligating | lingual
  wireSequence   String?  // JSON: [{ date, wire, notes }]
  planNotes      String?
  progressPhotos String?  // JSON: array of image URLs with dates
  status         String   @default("active") // active | paused | completed | cancelled
  totalCost      Float    @default(0)
  paidAmount     Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
}

model ImplantCase {
  id               String   @id @default(cuid())
  caseNo           String   @unique
  patientId        String
  doctorId         String?
  procedureId      String?
  toothNumber      String?
  site             String?  // upper/lower + anterior/posterior
  implantBrand     String?
  implantSize      String?  // diameter x length
  placementDate    DateTime @default(now())
  boneGraft        Boolean  @default(false)
  graftMaterial    String?
  sinusLift        Boolean  @default(false)
  healingAbutment  Boolean  @default(false)
  abutmentDate     DateTime?
  finalCrownDate   DateTime?
  followUpNotes    String?
  status           String   @default("placed") // placed | osseointegrating | restored | failed | maintained
  cost             Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
}

model DentalFollowup {
  id              String   @id @default(cuid())
  followupNo      String   @unique
  patientId       String
  doctorId        String?
  procedureId     String?
  treatmentPlanId String?
  type            String   // recall | procedure_review | healing_assessment | ortho_adjustment | implant_check
  scheduledDate   DateTime
  completedDate   DateTime?
  notes           String?
  status          String   @default("scheduled") // scheduled | completed | cancelled | no_show
  reminderSent    Boolean  @default(false)
  createdAt       DateTime @default(now())
}

// ============================================================
// Carelim MS Module — Standalone Add-on
// Distinguishes Carelim Patients (acquired via Carelim) from
// Clinic Patients (direct walk-in). Tracks source, referral,
// commission, patient journey, marketing attribution.
// Uses extension tables — does NOT modify existing HMS tables.
// References Patient/Appointment/Doctor/Invoice by ID only.
// ============================================================

model PatientSource {
  id          String   @id @default(cuid())
  patientId   String   // -> Patient.id (existing HMS)
  sourceType  String   // carelim | clinic
  sourceName  String   // website | mobile_app | call_center | whatsapp | facebook | google | landing_page | partner | walk_in | reception | phone | hospital_website | existing
  campaignId  String?  // -> Campaign.id (optional)
  clinicId    String?  // -> Branch.id (partner clinic)
  trackingId  String   @unique // CMS-XXXXX — for cross-clinic tracking
  createdBy   String?
  createdAt   DateTime @default(now())
}

model AppointmentExtension {
  id                 String   @id @default(cuid())
  appointmentId      String   @unique // -> Appointment.id (existing HMS)
  bookingSource      String   // CARELIM | CLINIC
  bookingChannel     String   // website | mobile_app | call_center | whatsapp | facebook | google | landing_page | walk_in | reception | phone
  carelimPatient     Boolean  @default(false)
  commissionEligible Boolean  @default(false)
  trackingId         String?  // -> PatientSource.trackingId
  status             String   @default("pending") // pending | confirmed | checked_in | consultation | billing | completed | cancelled | no_show
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
}

model Referral {
  id              String   @id @default(cuid())
  referralNo      String   @unique
  appointmentId   String?  // -> Appointment.id
  patientId       String   // -> Patient.id
  clinicId        String?  // -> Branch.id
  doctorId        String?  // -> Doctor.id
  referralSource  String   // facebook | google | whatsapp | website | instagram | call_center | referral | partner
  campaignId      String?  // -> Campaign.id
  commissionRate  Float    @default(0) // percentage
  commissionAmount Float   @default(0)
  billAmount      Float    @default(0)
  status          String   @default("pending") // pending | earned | settled | cancelled
  settledAt       DateTime?
  createdAt       DateTime @default(now())
}

model PatientActivityLog {
  id            String   @id @default(cuid())
  patientId     String   // -> Patient.id
  appointmentId String?  // -> Appointment.id
  activity      String   // appointment_booked | appointment_confirmed | checked_in | consultation | prescription_created | lab_ordered | billing_completed | commission_generated | followup_scheduled | sms_sent | whatsapp_sent
  description   String?
  performedBy   String?
  createdAt     DateTime @default(now())
}

model CareCoordinator {
  id           String   @id @default(cuid())
  patientId    String   // -> Patient.id
  coordinatorId String? // -> Staff.id or name
  coordinatorName String?
  status       String   @default("active") // active | paused | closed
  nextFollowup DateTime?
  remarks      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model MSLead {
  id          String   @id @default(cuid())
  leadNo      String   @unique
  patientName String
  phone       String
  email       String?
  source      String   // facebook | google | whatsapp | website | instagram | call_center | referral
  campaignId  String?
  clinicId    String?  // -> Branch.id
  doctorId    String?  // -> Doctor.id
  interest    String?  // IVF | Dental | Cardiology | General | etc.
  status      String   @default("new") // new | contacted | interested | appointment_booked | treatment_started | completed | lost
  convertedPatientId String? // -> Patient.id (when converted)
  convertedAt DateTime?
  notes       String?
  assignedTo  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model Campaign {
  id          String   @id @default(cuid())
  name        String   @unique
  platform    String   // facebook | google | instagram | whatsapp | website | call_center
  budget      Float    @default(0)
  spent       Float    @default(0)
  leads       Int      @default(0)
  conversions Int      @default(0)
  startDate   DateTime?
  endDate     DateTime?
  status      String   @default("active") // active | paused | completed
  createdAt   DateTime @default(now())
}

model CommissionSettlement {
  id          String   @id @default(cuid())
  settlementNo String  @unique
  referralId  String   // -> Referral.id
  clinicId    String?  // -> Branch.id
  doctorId    String?  // -> Doctor.id
  amount      Float
  status      String   @default("pending") // pending | paid
  paidAt      DateTime?
  month       String   // e.g. "2025-07"
  createdAt   DateTime @default(now())
}

// ============================================================
// Onboarding & Organization Models
// ============================================================

model Organization {
  id            String   @id @default(cuid())
  name          String
  clinicType    String
  registrationNo String?
  panVatNo      String?
  country       String?
  stateProvince String?
  city          String?
  fullAddress   String?
  googleMapUrl  String?
  logoUrl       String?
  clinicId      String   @unique
  subdomain     String   @unique
  status        String   @default("active") // active | suspended | inactive
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  // Relations
  adminUserId   String?
  subscriptions Subscription[]
  modules       OrganizationModule[]
  settings      OrganizationSetting[]
}

model OrganizationModule {
  id            String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  moduleKey     String
  moduleName    String
  category      String
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model Subscription {
  id            String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planName      String   // free_trial | starter | professional | enterprise
  planLabel     String
  price         Float    @default(0)
  currency      String   @default("NPR")
  billingCycle  String   @default("monthly") // monthly | yearly
  startDate     DateTime @default(now())
  trialEndsAt   DateTime?
  endDate       DateTime?
  status        String   @default("active") // active | cancelled | expired | trial
  couponCode    String?
  referralCode  String?
  paymentMethod String?
  maxUsers      Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

model OnboardingSession {
  id            String   @id @default(cuid())
  sessionId     String   @unique
  organizationData Json?
  selectedModules Json?
  selectedPlan    Json?
  currentStep     Int      @default(1)
  completedSteps  Json?    // [1, 2, 3]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

model OrganizationSetting {
  id            String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key           String
  value         String
  category      String   @default("general")
  @@unique([organizationId, key])
}

// ============================================================
// Patient Portal — Patient-facing authentication & features
// ============================================================

model PatientUser {
  id            String   @id @default(cuid())
  patientId     String?  @unique // links to existing Patient model
  name          String
  email         String   @unique
  password      String
  phone         String?
  avatar        String?
  status        String   @default("active") // active | inactive | suspended
  lastLogin     DateTime?
  createdAt     DateTime @default(now())
  documents     PatientDocument[]
  messages      PatientMessage[]
  notifications PatientNotification[]
  reminders     PatientReminder[]
}

model PatientDocument {
  id          String   @id @default(cuid())
  userId      String
  user        PatientUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  type        String   // pdf | image | other
  size        String   // e.g. "1.2 MB"
  fileData    String?  // base64 encoded file data
  uploadedAt  DateTime @default(now())
}

model PatientMessage {
  id          String   @id @default(cuid())
  userId      String
  user        PatientUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromName    String
  fromType    String   @default("provider") // provider | system | patient
  message     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model PatientNotification {
  id          String   @id @default(cuid())
  userId      String
  user        PatientUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        String   @default("info") // info | reminder | result | medication | payment | tip
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model PatientReminder {
  id          String   @id @default(cuid())
  userId      String
  user        PatientUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  time        String   // e.g. "Every day, 8:00 AM"
  type        String   @default("medication") // medication | appointment | health
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ============================================================
// CRM Module — Contact, Deal, Communication, Task, EmailTemplate
// ============================================================

model CRMContact {
  id            String   @id @default(cuid())
  contactNo     String   @unique // CON-XXXXX
  name          String
  email         String?
  phone         String
  company       String?  // hospital, clinic, pharmacy, corporate
  type          String   @default("patient") // patient | doctor | clinic | partner | vendor | corporate | other
  category      String   @default("general") // general | vip | corporate | insurance
  source        String   @default("manual") // website | referral | call_center | facebook | google | whatsapp | instagram | walk_in | manual
  assignedTo    String?
  tags          String?  // comma-separated tags
  address       String?
  city          String?
  notes         String?
  score         Int      @default(0) // lead score 0-100
  status        String   @default("active") // active | inactive | blocked
  lastContactAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  deals         CRMDeal[]
  communications CRMCommunication[]
  tasks         CRMTask[]
}

model CRMDeal {
  id            String   @id @default(cuid())
  dealNo        String   @unique // DEAL-XXXXX
  title         String
  contactId     String
  contact       CRMContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  stage         String   @default("qualification") // qualification | needs_analysis | proposal | negotiation | closed_won | closed_lost
  value         Float    @default(0) // estimated deal value in NPR
  currency      String   @default("NPR")
  probability   Int      @default(10) // 0-100%
  source        String   @default("manual") // facebook | google | whatsapp | website | instagram | call_center | referral | walk_in
  campaignId    String?  // -> Campaign.id
  clinicId      String?  // -> Branch.id
  doctorId      String?  // -> Doctor.id
  interest      String?  // IVF | Dental | Cardiology | General | etc.
  assignedTo    String?
  closedAt      DateTime?
  lostReason    String?
  notes         String?
  priority      String   @default("medium") // low | medium | high | urgent
  expectedClose DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  activities    CRMActivity[]
}

model CRMCommunication {
  id            String   @id @default(cuid())
  contactId     String
  contact       CRMContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type          String   // call | email | whatsapp | sms | meeting | note
  direction     String   @default("outbound") // inbound | outbound
  subject       String?
  body          String?
  outcome       String?  // reached | voicemail | no_answer | callback_requested | interested | not_interested
  duration      Int?     // minutes (for calls/meetings)
  scheduledAt   DateTime?
  completedAt   DateTime?
  assignedTo    String?
  createdAt     DateTime @default(now())
}

model CRMTask {
  id            String   @id @default(cuid())
  contactId     String?
  contact       CRMContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId        String?
  title         String
  description   String?
  type          String   @default("follow_up") // follow_up | call | meeting | email | sms | whatsapp | check_in | reminder | other
  priority      String   @default("medium") // low | medium | high | urgent
  status        String   @default("pending") // pending | in_progress | completed | cancelled
  dueDate       DateTime?
  completedAt   DateTime?
  assignedTo    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

model CRMActivity {
  id            String   @id @default(cuid())
  dealId        String
  deal          CRMDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  type          String   // stage_change | note | call | email | meeting | task_completed
  fromStage     String?
  toStage       String?
  description   String?
  performedBy   String?
  createdAt     DateTime @default(now())
}

model EmailTemplate {
  id            String   @id @default(cuid())
  name          String
  category      String   @default("general") // general | follow_up | appointment | promotion | welcome | feedback
  subject       String
  body          String   // HTML content
  variables     String?  // comma-separated variable names e.g. "{{patient_name}},{{doctor_name}}"
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}
