# PostgreSQL Database
POSTGRES_USER=carelim
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=carelim
DATABASE_URL="postgresql://carelim:CHANGE_ME_STRONG_PASSWORD@localhost:5432/carelim?schema=public"

# Authentication — generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND
NEXTAUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Backend API (if separate)
NEXT_PUBLIC_API_URL=

# Production example:
# DATABASE_URL="postgresql://carelim:xxx@db-host:5432/carelim?schema=public&connection_limit=5&pool_timeout=10"
# NEXTAUTH_URL=https://app.carelim.health
# FRONTEND_URL=https://app.carelim.health
# JWT_SECRET=<64-char random string>
