# Database
DATABASE_URL="postgresql://user:password@localhost:5432/carelim?schema=public"

# Authentication
# JWT_SECRET is used for signing authentication tokens.
# You can alternatively set NEXTAUTH_SECRET which will be used as a fallback.
JWT_SECRET="your-secure-random-secret-at-least-32-chars"
NEXTAUTH_SECRET="your-secure-random-secret-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Optional: Public API URL for client-side fetch calls
# NEXT_PUBLIC_API_URL="http://localhost:3001"
