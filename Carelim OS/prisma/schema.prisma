// ============================================================
// LIMS — Laboratory Information Management System
// ============================================================

model LabDepartment {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  headTechnician String?
  color       String   @default("#0d9488")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  tests       LabTestMaster[]
  equipment   LabEquipment[]
}

model LabTestMaster {
  id              String   @id @default(cuid())
  name            String
  code            String   @unique
  category        String   @default("Hematology")
  departmentId    String?
  department      LabDepartment? @relation(fields: [departmentId], references: [id])
  sampleType      String   @default("Blood") // Blood | Urine | Stool | Sputum | Tissue | CSF | Swab
  containerType   String   @default("EDTA Tube") // EDTA | Citrate | Heparin | Plain | Fluoride | Container
  volumeRequired  String   @default("3 ml")
  processingMethod String?
  turnaroundTime  String   @default("4 hours")
  price           Float    @default(0)
  taxRate         Float    @default(0)
  discountAllowed Boolean  @default(true)
  status          String   @default("active")
  isPackage       Boolean  @default(false)
  createdAt       DateTime @default(now())
  parameters      LabTestParameter[]
  orderItems      LabOrderItem[]
  packageTests    LabPackageTest[]
  qcRecords       LabQualityControl[]
}

model LabTestParameter {
  id          String   @id @default(cuid())
  testId      String
  test        LabTestMaster @relation(fields: [testId], references: [id], onDelete: Cascade)
  name        String
  unit        String?
  resultType  String   @default("numeric") // numeric | text | dropdown | positive-negative | reactive | image | file
  displayOrder Int     @default(1)
  options     String?  // for dropdown: comma-separated options
  referenceRanges LabReferenceRange[]
  resultParameters LabResultParameter[]
}

model LabReferenceRange {
  id          String   @id @default(cuid())
  parameterId String
  parameter   LabTestParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  gender      String   @default("all") // all | male | female | child
  ageMin      Int      @default(0)
  ageMax      Int      @default(120)
  lowNormal   String?
  highNormal  String?
  criticalLow String?
  criticalHigh String?
  textNormal  String?  // for text/positive-negative types
}

model LabPackage {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  price       Float    @default(0)
  discountPct Float    @default(0)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  tests       LabPackageTest[]
}

model LabPackageTest {
  id        String @id @default(cuid())
  packageId String
  package   LabPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  testId    String
  test      LabTestMaster @relation(fields: [testId], references: [id])
}

model LabOrder {
  id            String   @id @default(cuid())
  orderNo       String   @unique
  patientId     String
  patient       Patient @relation(fields: [patientId], references: [id])
  doctorId      String?
  priority      String   @default("normal") // normal | urgent | emergency
  clinicalNotes String?
  status        String   @default("ordered") // ordered | collected | processing | partial | completed | cancelled
  totalAmount   Float    @default(0)
  discount      Float    @default(0)
  tax           Float    @default(0)
  netAmount     Float    @default(0)
  paidAmount    Float    @default(0)
  paymentStatus String   @default("unpaid") // unpaid | partial | paid
  invoiceId     String?
  barcode       String?
  orderedAt     DateTime @default(now())
  collectedAt   DateTime?
  completedAt   DateTime?
  items         LabOrderItem[]
  samples       LabSample[]
  results       LabResult[]
}

model LabOrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     LabOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  testId    String
  test      LabTestMaster @relation(fields: [testId], references: [id])
  price     Float    @default(0)
  status    String   @default("ordered") // ordered | collected | processing | completed | approved | cancelled
  result    String?
  resultStatus String @default("pending") // pending | entered | verified | approved | released
  comments  String?
  results   LabResult[]
}

model LabSample {
  id          String   @id @default(cuid())
  sampleCode  String   @unique
  orderId     String
  order       LabOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  testId      String?
  sampleType  String
  containerType String
  barcode     String?
  qrCode      String?
  collectorId String?
  collectorName String?
  collectionTime DateTime?
  collectedAt String?
  receivedAt  DateTime?
  status      String   @default("pending") // pending | collected | rejected | recollected | processing | completed
  rejectionReason String?
  location    String?
  tracking    LabSampleTracking[]
}

model LabSampleTracking {
  id        String   @id @default(cuid())
  sampleId  String
  sample    LabSample @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  status    String
  location  String?
  handler   String?
  timestamp DateTime @default(now())
  notes     String?
}

model LabResult {
  id          String   @id @default(cuid())
  orderId     String
  order       LabOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  testId      String
  testItemId  String?
  testItem    LabOrderItem? @relation(fields: [testItemId], references: [id])
  status      String   @default("pending") // pending | entered | verified | approved | released | rejected
  technicianId String?
  technicianName String?
  verifiedBy  String?
  approvedBy  String?
  releasedBy  String?
  enteredAt   DateTime?
  verifiedAt  DateTime?
  approvedAt  DateTime?
  releasedAt  DateTime?
  pathologistComments String?
  rejectionReason String?
  reportVersion Int   @default(1)
  parameters  LabResultParameter[]
  createdAt   DateTime @default(now())
}

model LabResultParameter {
  id          String   @id @default(cuid())
  resultId    String
  result      LabResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  parameterId String
  parameter   LabTestParameter @relation(fields: [parameterId], references: [id])
  value       String?
  flag        String   @default("normal") // normal | high | low | critical | panic | abnormal
  comment     String?
}

model LabQualityControl {
  id          String   @id @default(cuid())
  code        String   @unique
  testId      String?
  test        LabTestMaster? @relation(fields: [testId], references: [id])
  equipmentId String?
  controlName String
  controlLevel String  @default("normal") // normal | high | low
  expectedValue String?
  observedValue String?
  deviation   String?
  status      String   @default("pass") // pass | fail | warning
  performedBy String?
  performedAt DateTime @default(now())
  comments    String?
}

model LabEquipment {
  id              String   @id @default(cuid())
  name            String
  serialNumber    String   @unique
  type            String   // analyzer | microscope | centrifuge | imaging | other
  manufacturer    String?
  model           String?
  departmentId    String?
  department      LabDepartment? @relation(fields: [departmentId], references: [id])
  purchaseDate    DateTime?
  warrantyExpiry  DateTime?
  lastCalibration DateTime?
  nextCalibration DateTime?
  maintenanceSchedule String?
  status          String   @default("operational") // operational | maintenance | breakdown
  createdAt       DateTime @default(now())
}

model LabInventory {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("reagent") // reagent | chemical | kit | consumable | tube | slide
  category    String?
  batchNo     String?
  expiryDate  DateTime?
  stockQty    Int      @default(0)
  reorderLevel Int     @default(20)
  unit        String   @default("unit")
  unitPrice   Float    @default(0)
  supplierId  String?
  supplier    LabSupplier? @relation(fields: [supplierId], references: [id])
  location    String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
}

model LabSupplier {
  id        String   @id @default(cuid())
  name      String
  contact   String
  email     String?
  phone     String
  address   String?
  createdAt DateTime @default(now())
  inventory LabInventory[]
}

// ============================================================
// Advanced Inventory Management System (AIMS)
// ============================================================

model InventoryLocation {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  type      String   @default("store") // pharmacy | store | icu | ot | emergency | lab | warehouse
  address   String?
  manager   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  stocks    InventoryStock[]
  transfersFrom StockTransfer[] @relation("transferFrom")
  transfersTo   StockTransfer[] @relation("transferTo")
  audits    StockAudit[]
}

model InventoryItem {
  id              String   @id @default(cuid())
  name            String
  genericName     String?
  brandName       String?
  category        String   @default("General") // Medicine | Medical Supplies | Equipment | Consumables
  subCategory     String?
  type            String   @default("medicine") // medicine | consumable | equipment
  dosage          String?
  form            String?  // tablet | capsule | syrup | injection | piece | box
  unit            String   @default("piece") // box | strip | piece | bottle | pack
  barcode         String?
  hsCode          String?
  // Medicine specific
  drugClass       String?
  composition     String?
  route           String?  // oral | IV | topical | inhalation
  schedule        String?  // prescription required | OTC
  controlledDrug  Boolean  @default(false)
  storageCondition String?
  // Pricing
  purchasePrice   Float    @default(0)
  sellingPrice    Float    @default(0)
  mrp             Float    @default(0)
  taxRate         Float    @default(0)
  // Stock params
  reorderLevel    Int      @default(20)
  minStock        Int      @default(10)
  maxStock        Int      @default(500)
  // Location
  rackNumber      String?
  shelfNumber     String?
  // Status
  status          String   @default("active")
  imageUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  stocks          InventoryStock[]
  batches         InventoryBatch[]
  movements       InventoryMovement[]
  transferItems   StockTransferItem[]
}

model InventoryBatch {
  id            String   @id @default(cuid())
  itemId        String
  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  batchNo       String
  manufactureDate DateTime?
  expiryDate    DateTime?
  quantity      Int      @default(0)
  purchasePrice Float    @default(0)
  sellingPrice  Float    @default(0)
  supplierName  String?
  receivedDate  DateTime @default(now())
  status        String   @default("active") // active | expired | quarantined
}

model InventoryStock {
  id          String   @id @default(cuid())
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  locationId  String
  location    InventoryLocation @relation(fields: [locationId], references: [id])
  quantity    Int      @default(0)
  reservedQty Int      @default(0)
  damagedQty  Int      @default(0)
  updatedAt   DateTime @default(now()) @updatedAt
}

model InventoryMovement {
  id          String   @id @default(cuid())
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  locationId  String?
  type        String   // purchase | sale | transfer | adjustment | damage | expiry | consumption | issue | return
  direction   String   @default("in") // in | out
  quantity    Int
  balanceAfter Int     @default(0)
  reference   String?
  reason      String?
  department  String?
  performedBy String?
  createdAt   DateTime @default(now())
}

model StockTransfer {
  id          String   @id @default(cuid())
  transferNo  String   @unique
  fromLocationId String
  fromLocation InventoryLocation @relation("transferFrom", fields: [fromLocationId], references: [id])
  toLocationId String
  toLocation   InventoryLocation @relation("transferTo", fields: [toLocationId], references: [id])
  status      String   @default("pending") // pending | approved | in-transit | received | cancelled
  notes       String?
  requestedBy String?
  approvedBy  String?
  receivedBy  String?
  transferDate DateTime @default(now())
  approvedAt  DateTime?
  receivedAt  DateTime?
  items       StockTransferItem[]
}

model StockTransferItem {
  id          String   @id @default(cuid())
  transferId  String
  transfer    StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id])
  quantity    Int
  receivedQty Int      @default(0)
}

model StockAudit {
  id          String   @id @default(cuid())
  auditNo     String   @unique
  locationId  String
  location    InventoryLocation @relation(fields: [locationId], references: [id])
  auditDate   DateTime @default(now())
  status      String   @default("draft") // draft | in-progress | completed
  performedBy String?
  notes       String?
  items       StockAuditItem[]
}

model StockAuditItem {
  id          String   @id @default(cuid())
  auditId     String
  audit       StockAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  itemId      String
  itemName    String
  systemQty   Int      @default(0)
  physicalQty Int      @default(0)
  variance    Int      @default(0)
  reason      String?
}

