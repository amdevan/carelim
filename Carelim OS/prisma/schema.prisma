// MedCore — Enterprise Clinic Management System
// Multi-tenant ready schema (tenantId on core entities)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Department {
  id          String   @id @default(cuid())
  name        String
  code        String
  description String?
  headDoctor  String?
  color       String   @default("#0d9488")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  doctors     Doctor[]
  appointments Appointment[]
}

model Doctor {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  phone          String
  gender         String   @default("male")
  qualification  String
  specialization String
  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id])
  licenseNumber  String
  experience     Int      @default(0)
  consultationFee Float   @default(0)
  commissionPct  Float    @default(0)
  rating         Float    @default(4.5)
  avatar         String?
  signature      String?
  workingDays    String   @default("Mon,Tue,Wed,Thu,Fri")
  startTime      String   @default("09:00")
  endTime        String   @default("17:00")
  status         String   @default("active") // active | on_leave | inactive
  createdAt      DateTime @default(now())
  appointments   Appointment[]
  prescriptions  Prescription[]
  scheduleSlots  DoctorScheduleSlot[]
}

model DoctorScheduleSlot {
  id          String   @id @default(cuid())
  doctorId    String
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayName     String   // Mon | Tue | Wed | Thu | Fri | Sat | Sun
  startTime   String   @default("09:00")
  endTime     String   @default("17:00")
  slotDuration Int     @default(15) // minutes per appointment
  capacity    Int      @default(20) // max appointments per slot/day
  bookedCount Int      @default(0)
  status      String   @default("available") // available | full | blocked | leave
  notes       String?
  createdAt   DateTime @default(now())
}

model Patient {
  id              String   @id @default(cuid())
  patientCode     String   @unique
  name            String
  email           String?
  phone           String
  gender          String   @default("male")
  dob             DateTime?
  age             Int      @default(0)
  bloodGroup      String?
  address         String?
  photo           String?
  bloodPressure   String?
  temperature     String?
  pulse           String?
  weight          Float?
  height          Float?
  bmi             Float?
  allergies       String?
  chronicConditions String?
  emergencyContact String?
  emergencyName   String?
  insuranceProvider String?
  insuranceNumber String?
  status          String   @default("active")
  registeredAt    DateTime @default(now())
  appointments    Appointment[]
  prescriptions   Prescription[]
  invoices        Invoice[]
  labTests        LabTest[]
  radiologyTests  RadiologyTest[]
  radiologyStudies RadiologyStudy[]
  clinicalNotes   ClinicalNote[]
  labOrders       LabOrder[]
}

model Appointment {
  id          String   @id @default(cuid())
  tokenNo     Int
  patientId   String
  patient     Patient @relation(fields: [patientId], references: [id])
  doctorId    String
  doctor      Doctor  @relation(fields: [doctorId], references: [id])
  departmentId String?
  department  Department? @relation(fields: [departmentId], references: [id])
  date        DateTime
  time        String
  type        String   @default("walk-in") // walk-in | online | video | follow-up | referral
  reason      String?
  referralName String?  // Name of referring doctor/hospital/clinic
  priority    String?  // low | normal | high | urgent
  status      String   @default("scheduled") // scheduled | checked-in | in-consult | completed | cancelled | no-show
  fee         Float    @default(0)
  notes       String?
  createdAt   DateTime @default(now())
}

model Prescription {
  id          String   @id @default(cuid())
  code        String   @unique
  patientId   String
  patient     Patient @relation(fields: [patientId], references: [id])
  doctorId    String
  doctor      Doctor  @relation(fields: [doctorId], references: [id])
  diagnosis   String?
  symptoms    String?
  vitals      String?
  advice      String?
  followUp    String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  items       PrescriptionItem[]
  // Rich clinical data matching the OPD prescription template (JSON string):
  // { chiefComplaints, presentIllness, history, examination, diagnosis detail,
  //   investigations, procedures, advice detail, referral, vitals detail }
  clinicalData String?
}

model PrescriptionItem {
  id            String   @id @default(cuid())
  prescriptionId String
  prescription  Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineName  String
  dosage        String
  frequency     String
  duration      String
  quantity      Int      @default(1)
  instructions  String?
}

model Medicine {
  id              String   @id @default(cuid())
  name            String
  genericName     String?
  strength        String?  // e.g. "500mg", "250mg/5ml"
  dosageForm      String?  // tablet, capsule, syrup, injection, ointment, drops, inhaler
  category        String   @default("General")
  therapeuticClass String? // antibiotic, analgesic, antacid, etc.
  manufacturer    String?
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  hsn             String?  // HSN/SKU code
  barcode         String?
  batchNo         String
  expiryDate      DateTime
  manufactureDate DateTime?
  storageCondition String? // room, cold chain, refrigerated
  rackNumber      String?
  shelfNumber     String?
  location        String?
  // Pricing
  purchasePrice   Float    @default(0)
  unitPrice       Float    @default(0)  // alias for purchasePrice
  mrp             Float    @default(0)
  salePrice       Float    @default(0)
  wholesalePrice  Float    @default(0)
  discountPct     Float    @default(0)
  taxRate         Float    @default(0)
  // Stock
  stockQty        Int      @default(0)
  reorderLevel    Int      @default(20)
  minStock        Int      @default(10)
  maxStock        Int      @default(500)
  reservedStock   Int      @default(0)
  openingStock    Int      @default(0)
  // Status flags
  status          String   @default("active") // active | inactive | out-of-stock
  prescriptionRequired Boolean @default(false)
  controlledDrug  Boolean  @default(false)
  narcotic        Boolean  @default(false)
  coldChain       Boolean  @default(false)
  // Image
  imageUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  // Relations
  stockMovements  StockMovement[]
  purchaseItems   PurchaseOrderItem[]
  saleItems       PharmacySaleItem[]
  batches         MedicineBatch[]
  purchaseReturns PurchaseReturn[]
  salesReturns    SalesReturn[]
}

model MedicineBatch {
  id            String   @id @default(cuid())
  medicineId    String
  medicine      Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batchNo       String
  expiryDate    DateTime
  manufactureDate DateTime?
  quantity      Int      @default(0)
  purchasePrice Float    @default(0)
  salePrice     Float    @default(0)
  mrp           Float    @default(0)
  supplierId    String?
  receivedDate  DateTime @default(now())
  status        String   @default("active") // active | expired | quarantined
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  contact   String
  email     String?
  phone     String
  address   String?
  gstin     String?  // GST/Tax number
  drugLicense String? // drug license number
  paymentTerms String?
  createdAt DateTime @default(now())
  purchases Purchase[]
  medicines Medicine[]
  purchaseOrders PurchaseOrder[]
}

model Purchase {
  id         String   @id @default(cuid())
  code       String   @unique
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  totalAmount Float   @default(0)
  status     String   @default("pending") // pending | received | cancelled
  date       DateTime @default(now())
}

model PurchaseOrder {
  id          String   @id @default(cuid())
  poNumber    String   @unique
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  orderDate   DateTime @default(now())
  expectedDate DateTime?
  receivedDate DateTime?
  status      String   @default("draft") // draft | sent | partial | received | cancelled
  subtotal    Float    @default(0)
  taxAmount   Float    @default(0)
  discountAmount Float @default(0)
  totalAmount Float    @default(0)
  paidAmount  Float    @default(0)
  notes       String?
  createdBy   String?
  items       PurchaseOrderItem[]
  grns        GRN[]
}

model PurchaseOrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicineId  String
  medicine    Medicine @relation(fields: [medicineId], references: [id])
  quantity    Int      @default(0)
  receivedQty Int      @default(0)
  unitPrice   Float    @default(0)
  taxPct      Float    @default(0)
  discountPct Float    @default(0)
  total       Float    @default(0)
}

model GRN {
  id          String   @id @default(cuid())
  grnNumber   String   @unique
  orderId     String
  order       PurchaseOrder @relation(fields: [orderId], references: [id])
  receivedDate DateTime @default(now())
  totalAmount Float    @default(0)
  notes       String?
  receivedBy  String?
}

model StockMovement {
  id          String   @id @default(cuid())
  medicineId  String
  medicine    Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  type        String   // purchase | sale | transfer | adjustment | damage | expiry | return | consumption
  quantity    Int      // positive for in, negative for out
  balanceAfter Int     @default(0)
  reference   String?  // PO number, invoice number, etc.
  notes       String?
  performedBy String?
  createdAt   DateTime @default(now())
}

model PharmacySale {
  id          String   @id @default(cuid())
  invoiceNo   String   @unique
  patientId   String?
  patientName String?
  doctorName  String?
  prescriptionRef String?
  subtotal    Float    @default(0)
  discount    Float    @default(0)
  tax         Float    @default(0)
  total       Float    @default(0)
  paidAmount  Float    @default(0)
  paymentMethod String @default("cash")
  paymentStatus String @default("paid") // paid | partial | due
  status      String   @default("completed") // completed | returned | cancelled
  saleDate    DateTime @default(now())
  items       PharmacySaleItem[]
}

model PharmacySaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        PharmacySale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicineId  String
  medicine    Medicine @relation(fields: [medicineId], references: [id])
  quantity    Int      @default(1)
  unitPrice   Float    @default(0)
  discount    Float    @default(0)
  total       Float    @default(0)
}

model PurchaseReturn {
  id          String   @id @default(cuid())
  returnNo    String   @unique
  orderId     String?
  supplierId  String?
  medicineId  String
  medicine    Medicine @relation(fields: [medicineId], references: [id])
  quantity    Int
  unitPrice   Float
  totalAmount Float
  reason      String?
  status      String   @default("pending") // pending | approved | completed
  date        DateTime @default(now())
}

model SalesReturn {
  id          String   @id @default(cuid())
  returnNo    String   @unique
  saleId      String?
  medicineId  String
  medicine    Medicine @relation(fields: [medicineId], references: [id])
  quantity    Int
  unitPrice   Float
  totalAmount Float
  reason      String?
  status      String   @default("pending")
  date        DateTime @default(now())
}

model Invoice {
  id          String   @id @default(cuid())
  invoiceNo   String   @unique
  patientId   String
  patient     Patient @relation(fields: [patientId], references: [id])
  type        String   @default("consultation") // consultation | pharmacy | lab | package | ipd
  subtotal    Float    @default(0)
  discount    Float    @default(0)
  tax         Float    @default(0)
  total       Float    @default(0)
  paid        Float    @default(0)
  due         Float    @default(0)
  status      String   @default("unpaid") // unpaid | partial | paid | refunded
  paymentMethod String?
  date        DateTime @default(now())
  items       InvoiceItem[]
}

model InvoiceItem {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  qty       Int      @default(1)
  rate      Float    @default(0)
  amount    Float    @default(0)
}

model LabTest {
  id          String   @id @default(cuid())
  testCode    String   @unique
  patientId   String
  patient     Patient @relation(fields: [patientId], references: [id])
  testName    String
  category    String   @default("Hematology")
  doctorId    String?
  status      String   @default("pending") // pending | collected | processing | completed | approved | cancelled
  result      String?
  referenceRange String?
  unit        String?
  fee         Float    @default(0)
  orderedAt   DateTime @default(now())
  completedAt DateTime?
}

model Staff {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String
  role         String   @default("receptionist")
  department   String?
  designation  String?
  salary       Float    @default(0)
  joinDate     DateTime @default(now())
  status       String   @default("active")
  attendance   StaffAttendance[]
  payrolls     Payroll[]
  leaveRequests LeaveRequest[]
}

model StaffAttendance {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date      DateTime
  checkIn   String?
  checkOut  String?
  status    String   @default("present") // present | absent | late | leave
}

model AuditLog {
  id        String   @id @default(cuid())
  user      String
  action    String
  module    String
  detail    String?
  ip        String?
  createdAt DateTime @default(now())
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// ===== Multi-Tenant & RBAC =====
model Branch {
  id              String   @id @default(cuid())
  tenantId        String?
  name            String
  code            String   @unique
  clinicType      String   @default("General")
  address         String?
  city            String?
  state           String?
  country         String?  @default("Nepal")
  zipCode         String?
  phone           String?
  email           String?
  website         String?
  timezone        String?  @default("Asia/Kathmandu")
  manager         String?
  capacity        Int      @default(50)
  operatingHours  String?  @default("09:00-17:00")
  logo            String?
  status          String   @default("active")
  createdAt       DateTime @default(now())
}

model ClinicSettings {
  id              String   @id @default(cuid())
  tenantId        String?  @unique
  clinicName      String?
  clinicEmail     String?
  clinicPhone     String?
  clinicWebsite   String?
  clinicLogo      String?
  address         String?
  city            String?
  state           String?
  country         String?  @default("Nepal")
  zipCode         String?
  timezone        String?  @default("Asia/Kathmandu")
  currency        String?  @default("NPR")
  currencySymbol  String?  @default("रू")
  locale          String?  @default("en")
  dateFormat      String?  @default("YYYY-MM-DD")
  timeFormat      String?  @default("24h")
  fiscalYearStart String?  @default("01-01")
  taxRate         Float    @default(0)
  taxEnabled      Boolean  @default(false)
  appointmentSlot Int      @default(15)
  maxAppointments Int      @default(50)
  autoReminder    Boolean  @default(true)
  reminderHours   Int      @default(24)
  smsEnabled      Boolean  @default(false)
  emailEnabled    Boolean  @default(true)
  whatsappEnabled Boolean  @default(false)
  logo            String?
  primaryColor    String?  @default("#0d9488")
  secondaryColor  String?  @default("#10b981")
  footerText      String?
  termsAndCond    String?
  privacyPolicy   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id        String   @id @default(cuid())
  module    String
  action    String   // view | create | edit | delete | print | export | approve | reject
  createdAt DateTime @default(now())
  roles     RolePermission[]
}

model RolePermission {
  roleId       String
  role         Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String   @default("medcore123")
  phone         String?
  roleId        String?
  role          Role?    @relation(fields: [roleId], references: [id])
  branchId      String?
  status        String   @default("active")
  lastLogin     DateTime?
  createdAt     DateTime @default(now())
}

// ===== Radiology =====
model RadiologyTest {
  id            String   @id @default(cuid())
  testCode      String   @unique
  patientId     String
  patient       Patient @relation(fields: [patientId], references: [id])
  modality      String   // X-Ray | CT Scan | MRI | ECG | Ultrasound | Mammography | Doppler | DEXA | Fluoroscopy
  bodyPart      String
  findings      String?
  impression    String?
  radiologist   String?
  status        String   @default("pending") // pending | captured | reported | approved | released
  imageUrl      String?
  fee           Float    @default(0)
  orderedAt     DateTime @default(now())
  completedAt   DateTime?
  // Extended fields
  doctorId      String?
  priority      String   @default("normal") // normal | urgent | stat
  clinicalNotes String?
  contrastUsed  Boolean  @default(false)
  studyId       String?
  scheduledAt   DateTime?
  reportedAt    DateTime?
  releasedAt    DateTime?
  technicianId  String?
  technicianName String?
  equipmentId   String?
  // AI
  aiFindings    String?
  aiConfidence  Float?
  aiFlagged     Boolean  @default(false)
  // Billing
  billingStatus String   @default("unpaid") // unpaid | paid | insurance
  // Audit
  createdBy     String?
  createdAt     DateTime @default(now())
}

model RadiologyModality {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  baseFee     Float    @default(0)
  contrastFee Float    @default(0)
  duration    Int      @default(30) // minutes
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  equipment   RadiologyEquipment[]
  studies     RadiologyStudy[]
}

model RadiologyEquipment {
  id              String   @id @default(cuid())
  name            String
  code            String   @unique
  modalityId      String
  modality        RadiologyModality @relation(fields: [modalityId], references: [id])
  manufacturer    String?
  model           String?
  serialNumber    String?
  location        String?
  status          String   @default("operational") // operational | maintenance | breakdown
  utilizationPct  Float    @default(0)
  lastServiceDate DateTime?
  nextServiceDate DateTime?
  createdAt       DateTime @default(now())
}

model RadiologyStudy {
  id              String   @id @default(cuid())
  studyUid        String   @unique
  orderId         String?
  patientId       String
  patient         Patient @relation(fields: [patientId], references: [id])
  modalityId      String
  modality        RadiologyModality @relation(fields: [modalityId], references: [id])
  bodyPart        String
  status          String   @default("scheduled") // scheduled | in-progress | completed | reported | released | cancelled
  priority        String   @default("normal") // normal | urgent | stat
  scheduledAt     DateTime?
  performedAt     DateTime?
  reportedAt      DateTime?
  releasedAt      DateTime?
  technicianName  String?
  radiologistName String?
  equipmentId     String?
  contrastUsed    Boolean  @default(false)
  clinicalHistory String?
  imageCount      Int      @default(0)
  createdAt       DateTime @default(now())
  images          DicomImage[]
  report          RadiologyReport?
}

model DicomImage {
  id          String   @id @default(cuid())
  studyId     String
  study       RadiologyStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)
  imageUrl    String
  thumbnailUrl String?
  instanceNumber Int   @default(1)
  description String?
  fileSize    Float?
  uploadedAt  DateTime @default(now())
  uploadedBy  String?
}

model RadiologyReport {
  id              String   @id @default(cuid())
  studyId         String   @unique
  study           RadiologyStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)
  examination     String?
  clinicalHistory String?
  technique       String?
  findings        String?
  impression      String?
  recommendations String?
  status          String   @default("draft") // draft | verified | released | revised
  radiologistName String?
  verifiedAt      DateTime?
  releasedAt      DateTime?
  reportVersion   Int      @default(1)
  templateId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

model RadiologyTemplate {
  id              String   @id @default(cuid())
  name            String
  modality        String
  bodyPart        String
  technique       String?
  defaultFindings String?
  defaultImpression String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model RadiologyAlert {
  id              String   @id @default(cuid())
  studyId         String?
  patientId       String?
  patientName     String?
  modality        String
  bodyPart        String?
  finding         String
  severity        String   @default("critical") // critical | urgent | moderate
  status          String   @default("active") // active | acknowledged | resolved
  aiConfidence    Float?
  doctorNotified  Boolean  @default(false)
  smsSent         Boolean  @default(false)
  erAlerted       Boolean  @default(false)
  acknowledgedBy  String?
  acknowledgedAt  DateTime?
  createdAt       DateTime @default(now())
}

model RadiologySchedule {
  id          String   @id @default(cuid())
  patientId   String
  patientName String?
  modality    String
  bodyPart    String
  equipmentId String?
  scheduledDate DateTime
  timeSlot    String
  status      String   @default("booked") // booked | confirmed | completed | cancelled | no-show
  doctorName  String?
  notes       String?
  createdAt   DateTime @default(now())
}

// ===== Accounting & Finance =====
model Expense {
  id          String   @id @default(cuid())
  code        String   @unique
  category    String   // rent | salary | utilities | supplies | maintenance | marketing | fuel | cleaning | other
  description String
  amount      Float
  paymentMode String   @default("cash") // cash | bank | cheque | online
  date        DateTime @default(now())
  status      String   @default("approved") // pending | approved | rejected
  approvedBy  String?
  createdBy   String?
  attachment  String?
}

model Payroll {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  month     String
  basicSalary Float
  allowance Float    @default(0)
  deduction Float    @default(0)
  tax        Float   @default(0)
  netPay    Float
  status    String   @default("pending") // pending | paid
  paidAt    DateTime?
}

model Account {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  type      String   // asset | liability | equity | income | expense
  group     String   // current_asset | fixed_asset | current_liability | long_term_liability | revenue | cogs | operating_expense
  parentId  String?
  balance   Float    @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  journalItems JournalItem[]
}

model JournalEntry {
  id          String   @id @default(cuid())
  entryNo     String   @unique
  date        DateTime @default(now())
  description String
  reference   String?  // invoice no, PO no, etc.
  module      String?  // billing | pharmacy | lab | radiology | purchase | payroll | expense | manual
  totalDebit  Float    @default(0)
  totalCredit Float    @default(0)
  status      String   @default("posted") // draft | posted | reversed
  createdBy   String?
  createdAt   DateTime @default(now())
  items       JournalItem[]
}

model JournalItem {
  id          String   @id @default(cuid())
  journalId   String
  journal     JournalEntry @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account @relation(fields: [accountId], references: [id])
  debit       Float    @default(0)
  credit      Float    @default(0)
  description String?
}

model PatientPayment {
  id            String   @id @default(cuid())
